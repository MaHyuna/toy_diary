{
  "name": "mongle-grooming-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && python scripts/build_routes.py dist",
    "build:demo": "tsc -b && vite build --mode demo && python scripts/build_routes.py demo-dist",
    "test:demo": "node --experimental-strip-types --test --test-isolation=none --test-timeout=10000 tests/demo.test.ts",
    "test:calendar": "node --experimental-strip-types --test --test-isolation=none --test-timeout=10000 tests/calendar.test.ts",
    "package:demo": "npm run build:demo && python scripts/package_demo.py",
    "start": "python -m server.app --host 127.0.0.1 --port 3000",
    "test": "python -m unittest discover -s tests -v",
    "test:studio": "node --test --test-isolation=none tests/price-studio.test.mjs",
    "test:care": "node --experimental-strip-types --test --test-isolation=none tests/care.test.ts",
    "test:routes": "node --experimental-strip-types --test --test-isolation=none tests/routes.test.ts",
    "test:auth:browser": "npm run build && python tests/browser_auth.py"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@react-spectrum/s2": "1.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jspdf": "^4.2.1",
    "opentype.js": "^2.0.0",
    "svg2pdf.js": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
